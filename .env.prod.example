# Copy this file to .env.prod on the EC2 host and replace every placeholder.
# Never commit .env.prod or share its contents.

# Application
SPRING_PROFILES_ACTIVE=prod
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# PostgreSQL
APP_DB_NAME=mentify
APP_DB_USERNAME=replace-with-app-db-username
APP_DB_PASSWORD=replace-with-app-db-password
AUTH_DB_NAME=auth
AUTH_DB_USERNAME=replace-with-auth-db-username
AUTH_DB_PASSWORD=replace-with-auth-db-password
USER_DB_NAME=user
USER_DB_USERNAME=replace-with-user-db-username
USER_DB_PASSWORD=replace-with-user-db-password
COURSE_DB_NAME=course
COURSE_DB_USERNAME=replace-with-course-db-username
COURSE_DB_PASSWORD=replace-with-course-db-password
ENTROLLMENT_DB_NAME=entrollment
ENTROLLMENT_DB_USERNAME=replace-with-entrollment-db-username
ENTROLLMENT_DB_PASSWORD=replace-with-entrollment-db-password
ASSIGNMENT_DB_NAME=assignment
ASSIGNMENT_DB_USERNAME=replace-with-assignment-db-username
ASSIGNMENT_DB_PASSWORD=replace-with-assignment-db-password
COMMUNICATION_DB_NAME=communication
COMMUNICATION_DB_USERNAME=replace-with-communication-db-username
COMMUNICATION_DB_PASSWORD=replace-with-communication-db-password
ATTENDANCE_DB_NAME=attendance
ATTENDANCE_DB_USERNAME=replace-with-attendance-db-username
ATTENDANCE_DB_PASSWORD=replace-with-attendance-db-password
EXAM_DB_NAME=exam
EXAM_DB_USERNAME=replace-with-exam-db-username
EXAM_DB_PASSWORD=replace-with-exam-db-password
AI_DB_NAME=ai
AI_DB_USERNAME=replace-with-ai-db-username
AI_DB_PASSWORD=replace-with-ai-db-password
PAYMENT_DB_NAME=payment
PAYMENT_DB_USERNAME=replace-with-payment-db-username
PAYMENT_DB_PASSWORD=replace-with-payment-db-password
MATERIAL_DB_NAME=material
MATERIAL_DB_USERNAME=replace-with-material-db-username
MATERIAL_DB_PASSWORD=replace-with-material-db-password
CALENDER_DB_NAME=calender
CALENDER_DB_USERNAME=replace-with-calender-db-username
CALENDER_DB_PASSWORD=replace-with-calender-db-password
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USERNAME=replace-with-notification-db-username
NOTIFICATION_DB_PASSWORD=replace-with-notification-db-password
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USERNAME=replace-with-analytics-db-username
ANALYTICS_DB_PASSWORD=replace-with-analytics-db-password

# Internal service URLs
EUREKA_URL=http://service-registry:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_INSTANCE_IP=
AUTH_SERVICE_URL=http://auth-service:8085
USER_SERVICE_URL=http://user-service:8081
COURSE_SERVICE_URL=http://course-service:8082
ENROLLMENT_SERVICE_URL=http://entrollment-service:8083
CALENDAR_SERVICE_URL=http://calender-service:8092

# JWT authentication
AUTH_ISSUER_URI=http://replace-with-public-api-host
AUTH_JWK_SET_URI=http://auth-service:8085/api/v1/auth/.well-known/jwks.json
AUTH_AUDIENCE=replace-with-jwt-audience
AUTH_JWT_KEY_ID=replace-with-jwt-key-id
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64-private-key
AUTH_JWT_PUBLIC_KEY_BASE64=replace-with-base64-public-key
AUTH_JWT_ALLOW_EPHEMERAL_KEYS=false
AUTH_INTERNAL_TOKEN=replace-with-internal-token
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_SECONDS=2592000
AUTH_SESSION_REFRESH_TOKEN_SECONDS=2592000
AUTH_INCLUDE_REFRESH_TOKEN=true
MENTIFY_SUPER_ADMIN_BOOTSTRAP_ENABLED=false
MENTIFY_SAMPLE_USERS_ENABLED=false

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-redis-password
REDIS_TIMEOUT_MS=2000

# Kafka and notifications
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
NOTIFICATION_KAFKA_ENABLED=true
NOTIFICATION_KAFKA_TOPIC=notifications
NOTIFICATION_KAFKA_GROUP_ID=notification-service
NOTIFICATION_EMAIL_RETRY_ENABLED=true
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
NOTIFICATION_EMAIL_RETRY_DELAY_MILLIS=1000

# CORS and frontend
GATEWAY_CORS_ALLOWED_ORIGIN_PATTERNS=http://replace-with-frontend-host
MENTIFY_LOGIN_URL=http://replace-with-frontend-host/login

# AWS S3; use the EC2 IAM role instead of access keys
AWS_REGION=ap-south-1
AWS_PROFILE=
MATERIAL_S3_BUCKET=replace-with-s3-bucket
MATERIAL_DOWNLOAD_URL_EXPIRATION=900

# Stripe
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_FROM=replace-with-smtp-from

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
AI_HTTP_CONNECT_TIMEOUT=5s
AI_HTTP_READ_TIMEOUT=60s
AI_RETRY_ENABLED=true
AI_RETRY_MAX_ATTEMPTS=3
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_REQUESTS_PER_DAY=1000
AI_PROMPT_INJECTION_DETECTION_ENABLED=true
AI_CONTENT_FILTERING_ENABLED=true
