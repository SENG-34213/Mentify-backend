:80 {
    encode gzip

    request_body {
        max_size 110MB
    }

    # Website server routes must reach Next.js first. Next.js then calls the
    # internal gateway with the correct public backend path and headers.
    handle /api/preregister {
        reverse_proxy website-frontend:3000
    }

    handle /api/contact {
        reverse_proxy website-frontend:3000
    }

    handle /api/marketplace/* {
        reverse_proxy website-frontend:3000
    }

    handle /api/payments/* {
        reverse_proxy website-frontend:3000
    }

    handle /api/resources/* {
        reverse_proxy website-frontend:3000
    }

    handle /api/* {
        reverse_proxy api-gateway:8080
    }

    handle /admin* {
        reverse_proxy admin-frontend:3000
    }

    handle /teacher* {
        reverse_proxy teacher-frontend:3000
    }

    handle /student* {
        reverse_proxy student-frontend:3000
    }

    handle {
        reverse_proxy website-frontend:3000
    }
}
