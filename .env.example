# ===============================
# Keycloak Runtime
# ===============================
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ===============================
# Keycloak Database
# ===============================
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_PORT=5433

# ===============================
# Mentify Realm
# ===============================
KEYCLOAK_REALM=mentify
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/mentify

# ===============================
# Keycloak Clients
# ===============================
KEYCLOAK_FRONTEND_CLIENT_ID=mentify-web-client
KEYCLOAK_BACKEND_CLIENT_ID=mentify-backend-client
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me

# ===============================
# Existing Local Database Tooling
# ===============================
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=change-me
APP_DB_NAME=mentify
APP_DB_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
