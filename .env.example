# ===============================
# Keycloak Runtime
# ===============================
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ===============================
# Keycloak Database
# ===============================
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_PORT=5433

# ===============================
# Mentify Realm
# ===============================
KEYCLOAK_REALM=mentify
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/mentify

# ===============================
# Keycloak Clients
# ===============================
KEYCLOAK_FRONTEND_CLIENT_ID=mentify-web-client
KEYCLOAK_BACKEND_CLIENT_ID=mentify-backend-client
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me
KEYCLOAK_AUTH_CLIENT_ID=mentify-backend-client
KEYCLOAK_AUTH_CLIENT_SECRET=change-me
KEYCLOAK_INCLUDE_REFRESH_TOKEN_IN_LOGIN_RESPONSE=true

# Optional Keycloak realm setting reference. Configure this in Keycloak; the backend does not issue reset tokens.
KEYCLOAK_RESET_TOKEN_TTL_SECONDS=

# ===============================
# Keycloak Bootstrap Super Admin
# ===============================
KEYCLOAK_BOOTSTRAP_SUPER_ADMIN_ENABLED=true
KEYCLOAK_BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@gmail.com
KEYCLOAK_BOOTSTRAP_SUPER_ADMIN_PASSWORD=SuperAdmin@123
KEYCLOAK_BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
KEYCLOAK_BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin
KEYCLOAK_BOOTSTRAP_SUPER_ADMIN_RESET_PASSWORD=true


# ===============================
# User Service Database
# ===============================
USER_DB_NAME=user_db
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=root
USER_DB_PORT=5434

# ===============================
# Course Service Database
# ===============================
COURSE_DB_NAME=course_dbb
COURSE_DB_USERNAME=postgres
COURSE_DB_PASSWORD=root
COURSE_DB_PORT=5434

# ===============================
# Entrollment Service
# ===============================
ENTROLLMENT_SERVICE_PORT=8083

# ===============================
# Entrollment Service Database
# ===============================
ENTROLLMENT_DB_NAME=entrollment_db
ENTROLLMENT_DB_USERNAME=postgres
ENTROLLMENT_DB_PASSWORD=root
ENTROLLMENT_DB_PORT=5434

# ===============================
# Assignment Service
# ===============================
ASSIGNMENT_SERVICE_PORT=8084

# ===============================
# Assignment Service Database
# ===============================
ASSIGNMENT_DB_NAME=assignment_db
ASSIGNMENT_DB_USERNAME=postgres
ASSIGNMENT_DB_PASSWORD=root
ASSIGNMENT_DB_PORT=5434

# ===============================
# Communication Service
# ===============================
COMMUNICATION_SERVICE_PORT=8086

# ===============================
# Communication Service Database
# ===============================
COMMUNICATION_DB_NAME=communication_db
COMMUNICATION_DB_USERNAME=postgres
COMMUNICATION_DB_PASSWORD=root
COMMUNICATION_DB_PORT=5434



# ===============================
# Communication Service
# ===============================
ATTENDANCE_SERVICE_PORT=8087

# ===============================
# Communication Service Database
# ===============================
ATTENDANCE_DB_NAME=attendance_db
ATTENDANCE_DB_USERNAME=postgres
ATTENDANCE_DB_PASSWORD=root
ATTENDANCE_DB_PORT=5434




#-------------------
# NVD API KEY
#----------
# NVD_API_KEY=change-me

# ===============================
# AI Service
# ===============================
AI_SERVICE_PORT=8087

# ===============================
# AI Service Database
# ===============================
AI_DB_NAME=ai_db
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=root
AI_DB_PORT=5434
AI_DB_HOST=localhost

# ===============================
# AI Provider Configuration
# ===============================
# Active provider: openai, gemini
AI_PROVIDER=gemini

# OpenAI Configuration
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Legacy / Default AI API Key (used if provider-specific key is not set)
AI_API_KEY=
AI_MODEL=gemini-3-flash-preview
