# ===============================
# AI Service
# ===============================
AI_SERVICE_PORT=8087

# ===============================
# AI Service Database
# ===============================
AI_DB_NAME=ai_db
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=root
AI_DB_PORT=5434
AI_DB_HOST=localhost

# ===============================
# AI Provider Configuration
# ===============================
# Active provider: openai, gemini
AI_PROVIDER=gemini

# OpenAI Configuration
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o
AI_OPENAI_COST_INPUT_TOKEN_COST_PER_MILLION=
AI_OPENAI_COST_OUTPUT_TOKEN_COST_PER_MILLION=

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_GEMINI_COST_INPUT_TOKEN_COST_PER_MILLION=
AI_GEMINI_COST_OUTPUT_TOKEN_COST_PER_MILLION=

# Legacy / Default AI API Key (used if provider-specific key is not set)
AI_API_KEY=
AI_MODEL=gemini-3-flash-preview

# AI resilience configuration
AI_HTTP_CONNECT_TIMEOUT=5s
AI_HTTP_READ_TIMEOUT=60s
AI_RETRY_ENABLED=true
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF=500ms
AI_CIRCUIT_BREAKER_ENABLED=true
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_OPEN_DURATION=30s
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_REQUESTS_PER_DAY=100
AI_MAX_INPUT_CHARACTERS=12000
AI_PROMPT_INJECTION_DETECTION_ENABLED=true
AI_CONTENT_FILTERING_ENABLED=true
AI_BLOCKED_TERMS=
