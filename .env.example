SPRING_PROFILES_ACTIVE=local

# ===============================
# Shared Redis
# ===============================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DATABASE=0
REDIS_TIMEOUT_MS=2000
REDIS_CACHE_DEFAULT_TTL_SECONDS=300
REDIS_LOCK_DEFAULT_TTL_SECONDS=30
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_IP=127.0.0.1
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=30s

AUTH_ISSUER_URI=http://localhost:8085
AUTH_JWK_SET_URI=http://localhost:8085/api/v1/auth/.well-known/jwks.json
AUTH_SERVICE_PORT=8085
AUTH_SERVICE_URL=http://localhost:8085
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=root
AUTH_DB_PORT=5432
AUTH_INTERNAL_TOKEN=change-me-internal-auth-token
AUTH_AUDIENCE=mentify-api
AUTH_ACCESS_TOKEN_SECONDS=86400
AUTH_REFRESH_TOKEN_SECONDS=86400
AUTH_SESSION_REFRESH_TOKEN_SECONDS=86400
AUTH_INCLUDE_REFRESH_TOKEN=true
AUTH_JWT_ALLOW_EPHEMERAL_KEYS=false

# One-time local bootstrap for the first SUPER_ADMIN.
MENTIFY_SUPER_ADMIN_BOOTSTRAP_ENABLED=false
MENTIFY_SUPER_ADMIN_EMAIL=superadmin@example.com
MENTIFY_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
MENTIFY_SUPER_ADMIN_FIRST_NAME=System
MENTIFY_SUPER_ADMIN_LAST_NAME=Administrator
MENTIFY_SUPER_ADMIN_ADDRESS_LINE1=System address
MENTIFY_SUPER_ADMIN_CITY=Colombo
MENTIFY_SUPER_ADMIN_DISTRICT=Colombo
AUTH_JWT_KEY_ID=mentify-auth-rsa
# Generate an RSA PKCS#8 private key and X.509 public key for production.
# Leave blank for local development; a temporary key is generated at startup.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=

# ===============================
# Development Sample Login Users
